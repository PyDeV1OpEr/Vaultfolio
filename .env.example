# Vaultfolio environment configuration
#
# Copy to `.env.local` (that exact name is git-ignored) and fill in values.
# Every variable here is PUBLIC CLIENT configuration read by Vite
# (import.meta.env.*). Vite only exposes variables prefixed with VITE_.
#
# Vaultfolio works out of the box in demo mode with none of these set.
# Set the two Supabase variables to unlock cloud mode (accounts + RLS).

# --- Supabase cloud mode (optional; required together, both public) ---
# Values come from your Supabase project: Settings → API.
# The anon key is public by design: Row Level Security enforces privacy.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PROJECT_ANON_KEY

# --- Precious-metal market data (optional) ---
# Base URL of a JSON price provider; Vaultfolio normalizes the response to
# LKR per gram for gold (24k) and silver (fine).
#
# SECURITY: anything in this URL is embedded into the shipped JS bundle.
# Only use a provider whose endpoint identifies YOU by URL, never one
# whose URL embeds a secret API key. For keyed providers, put a tiny
# proxy in front and point this variable at the proxy.
#
# Expected JSON shape:
# {
#   "goldPerGramLkr": 26450,
#   "silverPerGramLkr": 108.5,
#   "usdLkr": 297.5,
#   "asOf": "2026-01-01T09:00:00+05:30"   (optional, ISO 8601)
# }
VITE_METALS_API_URL=https://your-price-proxy.example/prices.json
VITE_METALS_API_LABEL=Your Price Provider
