{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vaultfolio",
  "version": "1.2.0",
  "identifier": "com.vaultfolio.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Vaultfolio",
        "width": 1180,
        "height": 800,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "img-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https:*.supabase.co wss:*.supabase.co https:",
        "worker-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Finance",
    "publisher": "Vaultfolio",
    "copyright": "© 2026 Vaultfolio",
    "shortDescription": "Private wealth tracking for physical assets",
    "longDescription": "Vaultfolio helps you track, organize and estimate the value of physical assets — gold & silver, gems & jewelry, watches, land & property, cars, motorcycles and more. One private portfolio, transparent valuations, clearly-labeled data sources.",
    "resources": {
      "../ml-engine/runtime": "ml-engine/runtime",
      "../ml-engine/service": "ml-engine/service",
      "../ml-engine/samples": "ml-engine/samples",
      "../ml-engine/documentation": "ml-engine/documentation",
      "../ml-engine/licenses": "ml-engine/licenses"
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
